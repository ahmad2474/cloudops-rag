# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Providers: stub (offline, deterministic) or bedrock ---
LLM_PROVIDER=stub
LLM_MODEL=amazon.nova-lite-v1:0
EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
RERANKER_PROVIDER=stub
RERANKER_MODEL=cohere.rerank-v3-5:0

# --- Retrieval pipeline (Phase 4) ---
# vector | bm25 | hybrid_rrf | hybrid_weighted
RETRIEVAL_STRATEGY=vector
RETRIEVAL_CANDIDATES=50
RETRIEVAL_TOP_K=8
FUSION_RRF_K=60
FUSION_VECTOR_WEIGHT=0.5
RERANK_ENABLED=false
RERANK_CANDIDATES=20
# parent | child | child_window  (what each retrieved child expands to before generation)
CONTEXT_MODE=parent
CONTEXT_WINDOW=1
# rules (free, deterministic) | llm (adds one model call to decompose multi-part questions)
QUERY_UNDERSTANDING=rules

# --- Search ---
SEARCH_PROVIDER=opensearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=cloudops

# --- Auth (Phase 7) ---
# >= 32 chars; the in-code default is refused when APP_ENV=aws
AUTH_SECRET=local-dev-secret-change-me-please-32chars!!
AUTH_TOKEN_TTL_SECONDS=3600
# JSON map of users → bcrypt hash + roles. Generate a hash with:
#   uv run python -c "from cloudops_rag.security import hash_password; print(hash_password('pw'))"
AUTH_USERS=
# Dev-only X-Acme-Role header (ignored when APP_ENV=aws)
AUTH_ALLOW_ROLE_HEADER=true

# --- AWS (credentials come from the standard AWS chain; never commit real values) ---
AWS_REGION=us-east-1
# Bedrock providers refuse to run unless this is true. Flip it only for an approved run.
ALLOW_AWS_CALLS=false
