# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Providers: stub (offline, deterministic) or bedrock ---
LLM_PROVIDER=stub
LLM_MODEL=amazon.nova-lite-v1:0
EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
RERANKER_PROVIDER=stub

# --- Search ---
SEARCH_PROVIDER=opensearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=cloudops

# --- AWS (credentials come from the standard AWS chain; never commit real values) ---
AWS_REGION=us-east-1
# Bedrock providers refuse to run unless this is true. Flip it only for an approved run.
ALLOW_AWS_CALLS=false
