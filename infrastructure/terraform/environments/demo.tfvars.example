# Copy to environments/demo.tfvars (gitignored) and fill in. Never commit the real file.
allowed_cidr    = "203.0.113.7/32"        # `curl -s https://checkip.amazonaws.com`/32
alarm_email     = "you@example.com"
image_tag       = "abc1234"               # printed by `make aws-push`
auth_secret     = "replace-with-32-plus-random-characters-openssl-rand-hex-32"
auth_users_json = "[]"                    # paste the JSON printed by `make auth-demo`
# create_opensearch_service_linked_role = true   # first VPC domain in this account only
